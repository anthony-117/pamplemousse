root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

# Test names read as sentences (Ping_returns_service_name), so underscores are allowed there.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
