<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pamplemousse.Application\Pamplemousse.Application.csproj" />
    <ProjectReference Include="..\Pamplemousse.Domain\Pamplemousse.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Google.Cloud.Firestore" />
    <PackageReference Include="FirebaseAdmin" />
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <!-- Reference data (GeoNames cities, mledoze countries, Passport Index visas) ships inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="ReferenceData\Data\*.gz" LogicalName="ReferenceData.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pamplemousse.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
