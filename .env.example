# Copy to .env (git-ignored) and fill in. Real environment variables always win over this file.
# Every variable is documented in src/Pamplemousse.Api/Env.cs.

# Attractions and restaurants (https://dev.opentripmap.org, free key).
OPENTRIPMAP_API_KEY=

# Events (https://developer.ticketmaster.com, free key).
TICKETMASTER_API_KEY=

# Flights (https://www.travelpayouts.com, free partner account). The marker is your partner ID, added to booking links.
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=

# Comma-separated browser origins allowed in production, e.g. https://travelgenie.web.app
CORS_ALLOWED_ORIGINS=
