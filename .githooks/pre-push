#!/bin/sh
# Blocks `git push` unless formatting, the analyzers and EVERY test pass (the same checks as CI).
# Installed by scripts/install-hooks.sh (git config core.hooksPath .githooks).
# Emergency bypass, only if you know CI will catch it: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

step() { printf '\n\033[1mpre-push: %s\033[0m\n' "$1"; }

step "formatting (dotnet format --verify-no-changes)"
dotnet format Pamplemousse.slnx --verify-no-changes

step "build + analyzers (any finding fails)"
dotnet build Pamplemousse.slnx -c Release -nologo -v quiet

step "tests (every test must pass)"
dotnet test Pamplemousse.slnx -c Release --no-build -nologo -v quiet

printf '\n\033[32mpre-push: all checks passed, pushing.\033[0m\n'
